<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Otto</AssemblyName>
    <RootNamespace>Otto</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Otto</Product>
    <Company>bam-rip</Company>
    <Authors>bam-rip</Authors>
    <Copyright>Copyright (c) 2026 bam-rip</Copyright>
    <Description>An AI assistant that operates your Windows PC</Description>
    <Version>1.2.3</Version>
    <ApplicationIcon>assets\otto.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- UI Automation (UiTree) lives in the WPF pack; referencing it directly keeps WinForms implicit usings intact -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <EmbeddedResource Include="assets\otto-tray.ico" LogicalName="otto-tray.ico" />
    <EmbeddedResource Include="assets\otto.ico" LogicalName="otto.ico" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- the test project lives under tests\ and builds separately -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <InternalsVisibleTo Include="Otto.Tests" />
  </ItemGroup>
</Project>
